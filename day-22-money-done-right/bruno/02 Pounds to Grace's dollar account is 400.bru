meta {
  name: Pounds to Grace's dollar account is 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accounts/1/transfers
  body: json
  auth: basic
}

headers {
  Idempotency-Key: ada-to-usd-{{toAccountId}}
}

auth:basic {
  username: ada
  password: ada-pass
}

body:json {
  {
    "toAccountId": 2,
    "amount": 50.00
  }
}

assert {
  res.status: eq 400
  res.body.title: eq "Currency mismatch"
}
