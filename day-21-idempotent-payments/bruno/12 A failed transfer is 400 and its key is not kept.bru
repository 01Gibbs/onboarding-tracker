meta {
  name: A failed transfer is 400 and its key is not kept
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/accounts/1/transfers
  body: json
  auth: basic
}

headers {
  Idempotency-Key: ada-too-much-{{toAccountId}}
}

auth:basic {
  username: ada
  password: ada-pass
}

body:json {
  {
    "toAccountId": "{{toAccountId}}",
    "amount": 1000000
  }
}

assert {
  res.status: eq 400
}
