meta {
  name: Ada retries with the same key
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/accounts/1/transfers
  body: json
  auth: basic
}

headers {
  Idempotency-Key: ada-pays-grace-{{toAccountId}}
}

auth:basic {
  username: ada
  password: ada-pass
}

body:json {
  {
    "toAccountId": "{{toAccountId}}",
    "amount": 50.00
  }
}

assert {
  res.status: eq 204
}
