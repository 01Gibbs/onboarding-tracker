meta {
  name: A teller may reuse Ada's key value (keys are per user)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/accounts/1/transfers
  body: json
  auth: basic
}

headers {
  Idempotency-Key: ada-pays-grace-{{toAccountId}}
}

auth:basic {
  username: teller
  password: teller-pass
}

body:json {
  {
    "toAccountId": "{{toAccountId}}",
    "amount": 50.00
  }
}

assert {
  res.status: eq 204
}
