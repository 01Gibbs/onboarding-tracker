meta {
  name: The teller's list is masked too
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accounts
  body: none
  auth: basic
}

auth:basic {
  username: teller
  password: teller-pass
}

assert {
  res.status: eq 200
  res.body[0].accountNumber: eq "****5678"
  res.body[1].accountNumber: eq "****4321"
}
