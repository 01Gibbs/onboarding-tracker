meta {
  name: Blank owner on update is 400
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/accounts/{{accountId}}
  body: json
  auth: none
}

body:json {
  {
    "owner": ""
  }
}

assert {
  res.status: eq 400
  res.headers.content-type: contains problem+json
  res.body.title: eq "Invalid request"
}
